# Backend
DATABASE_URL=postgresql+psycopg://smartcity:smartcity@db:5432/smartcity
REDIS_URL=redis://redis:6379/0
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:3000

# Agent bot — leave LLM_PROVIDER empty to use the rule-based fallback.
# Supported: "groq", "openai". Set the matching *_API_KEY below.
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=15
GROQ_API_KEY=
OPENAI_API_KEY=

# Geolocation
GEOIP_PROVIDER=ip-api
GEOIP_API_KEY=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
